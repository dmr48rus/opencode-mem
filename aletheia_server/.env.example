# Copy to .env and set the public address before 'docker compose up'.
#
# TLS is terminated by the Nginx Proxy Manager this host already runs, so this
# file is not a certificate setup -- it only tells deploy.sh which address to
# verify afterwards. Certificate issuance stays with NPM, deliberately: a second
# terminator here would fight over 80/443 and split the ACME account.
#
# The store itself is reachable two ways:
#   - from inside dockerbee: http://remote-mem:4747  (what NPM forwards to)
#   - from this host:        http://127.0.0.1:4747   (loopback, debugging)
REMOTE_MEM_PUBLIC_URL=https://mem.agrohim.info

# Password for the plugin's own HTTP Basic login, used by the web UI at
# REMOTE_MEM_PUBLIC_URL. Not the API token: /api/* is guarded by
# data/.opencode-mem/.auth-token, and this password only opens the page and its
# assets. Leaving it unset does not disable the UI -- it makes the plugin refuse
# non-loopback origins, and the page loads as an empty shell whose own scripts
# 403. Never inline the value here.
#
# The login name is not a variable: it is the literal "admin" in
# config/opencode-mem.jsonc, because the plugin passes webServerAuthUsername
# through un-resolved (only the password goes through env://).
REMOTE_MEM_WEB_PASSWORD=

# Key for the local model (docker-compose.llm.yml). The store sends it to the
# model server and the model server refuses anyone without it. Generate one:
#     openssl rand -hex 16
# The same value must be in the container (the compose passes it) and in the
# store's config (which reads it through env://REMOTE_MEM_LLM_KEY). Without it
# the local model stays down and the tag migration reports that the external
# API is not configured - which is where it was before the model existed.
REMOTE_MEM_LLM_KEY=